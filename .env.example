# Database
# For Supabase pooler (port 6543), append ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/uno?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/uno?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary
# Photo URL validation in src/lib/validators/property.ts pins listing photos
# to res.cloudinary.com/<NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME>/. See
# docs/security.md for the recommended account-level upload restrictions.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis — backs every rate limiter in src/lib/ratelimit.ts.
# Required in production; without it, rate-limited routes will error.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Google OAuth (optional — enables "Sign in with Google" + social connect in settings)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mapbox
# Public token: tiles/styles only. Restrict to your prod + preview domains
# via Mapbox dashboard → token settings → URL allowlist. Never grant geocoding
# scopes to this one — it ends up in the client bundle.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Server token: used by /api/geocode + /api/reverse-geocode proxies. Should
# have geocoding scopes and NO URL restriction (server-only). Never expose.
MAPBOX_SERVER_TOKEN=""
