# Database
# For Supabase pooler (port 6543), append ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/uno?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/uno?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Public origin for metadata, Open Graph tags, sitemap.xml and robots.txt.
# Must be the externally reachable URL of this deployment, with no trailing
# slash. Falls back to siteConfig.url, then localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth (optional — enables "Sign in with Google" + social connect in settings)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email — OTP auth codes, contact-lead notifications)
RESEND_API_KEY=""
EMAIL_FROM="Hoomefynda <onboarding@resend.dev>"

# Mapbox
# Public token: tiles/styles only. Restrict to your prod + preview domains
# via Mapbox dashboard → token settings → URL allowlist. Never grant geocoding
# scopes to this one — it ends up in the client bundle.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Server token: used by /api/geocode + /api/reverse-geocode proxies. Should
# have geocoding scopes and NO URL restriction (server-only). Never expose.
MAPBOX_SERVER_TOKEN=""

# Upstash Redis (rate limiting on auth, contact, geocode, upload-signing and listing create)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Deployment environment: DEV | STAGING | STANDBY | PROD. Drives the non-production
# banner and the admin/agent badge. Listing creation is limited to admins and
# in-house agents unless this is exactly STAGING or DEV (unset counts as live),
# so set NEXT_PUBLIC_APP_ENV=DEV in your local .env to test listing as a renter.
NEXT_PUBLIC_APP_ENV=DEV

# QStash (scheduled jobs). Copy both signing keys from the Upstash console > QStash.
# Job endpoints under /api/jobs/* answer 401 to every request while these are empty.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
