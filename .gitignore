# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#root
*.pdf
*.md.pdf
/.vscode

# Planning / vision docs stay local. Scoped to these directories rather than a
# blanket *.md so that README.md — or any markdown genuinely meant for the
# repo — isn't silently untracked.
/vision/**/*.md
/docs/**/*.md

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude
.claude/

# kilo
.kilo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env*.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


#html
emailt-templat.html
email template.html
.env*
