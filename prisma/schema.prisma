generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  phone           String?
  phoneVerified   Boolean   @default(false)
  name            String
  photo           String?
  gender          Gender?
  address         String?
  role            Role      @default(RENTER)

  // Agent fields. agentStatus gates access to /agent/* console.
  // agentEmployment distinguishes salaried UNO staff (IN_HOUSE) from
  // self-serve verified agents (EXTERNAL, Phase 2). Both render under the
  // UNO institutional badge in Phase 1 — only IN_HOUSE ships now.
  agentStatus       AgentStatus     @default(NONE)
  agentEmployment   AgentEmployment?
  agentSlug         String?         @unique
  agentBio          String?
  agentPhoto        String?
  agentTerritory    String[]        @default([])
  agentVerifiedAt   DateTime?
  agentVerifiedBy   String?
  // Phase 2 reserved — nullable so adding them later is non-breaking.
  agentBusinessType AgentBusinessType?
  agentBusinessName String?
  subscriptionTier  String?
  listingCredits    Int?

  landlordProfile LandlordProfile?
  properties      Property[]
  propertyDrafts  PropertyDraft[]
  favourites      Favourite[]
  savedSearches   SavedSearch[]
  contactsSent    ContactRequest[] @relation("TenantContacts")
  otpCodes        OtpCode[]
  reviewsReceived AgentReview[]    @relation("AgentReviewed")
  reviewsAuthored AgentReview[]    @relation("AgentReviewAuthor")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([phone])
  @@index([agentStatus, agentEmployment])
}

enum AgentStatus {
  NONE
  PENDING
  VERIFIED
  SUSPENDED
}

enum AgentEmployment {
  IN_HOUSE
  EXTERNAL
}

enum AgentBusinessType {
  INDIVIDUAL
  AGENCY
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model OtpCode {
  id          String    @id @default(cuid())
  email       String
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  codeHash    String
  purpose     OtpPurpose
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  EMAIL_CHANGE
}

enum Role {
  RENTER
  LANDLORD
  AGENT
  ADMIN
}

model LandlordProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id])
  whatsappNumber      String?
  bio                 String?
  landlordType        LandlordType      @default(INDIVIDUAL)
  idVerified          Boolean           @default(false)
  idDocumentType      String?
  verificationLevel   VerificationLevel @default(BASIC)
  contactMethod       ContactMethod     @default(WHATSAPP)
  availableDays       String[]
  availableHoursStart String?
  availableHoursEnd   String?
  totalProperties     Int               @default(0)
  responseRate        Float             @default(0)
  avgResponseTime     Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum LandlordType {
  INDIVIDUAL
  PROPERTY_MANAGER
  AGENT
}

enum VerificationLevel {
  BASIC
  ADVANCED
  PREMIUM
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

model Property {
  id                  String             @id @default(cuid())
  landlordId          String
  landlord            User               @relation(fields: [landlordId], references: [id])
  title               String
  propertyKind        PropertyKind       @default(RESIDENTIAL)
  propertyType        PropertyType
  bedrooms            Int
  bathrooms           Int
  description         String?
  size                Int?
  yearBuilt           Int?
  furnishing          Furnishing?
  condition           String?
  floorNumber         String?
  amenities           String[]
  customAmenities     String[]
  // Structured facts (Phase 2 will populate from amenities step)
  parkingSpaces       Int?
  powerBackup         String?
  waterSource         String?
  internetReady       Boolean?
  // Commercial-specific
  floorAreaSqm        Int?
  floorLevel          String?
  units               Int?
  fitOutState         String?
  // Land-specific
  plotSizeSqm         Int?
  titleDocType        String?
  surveyAvailable     Boolean?
  topography          String?
  accessRoad          String?
  fencing             Boolean?
  photos              PropertyPhoto[]
  city                String
  area                String
  lga                 String?
  streetAddress       String?
  landmark            String?
  latitude            Float?
  longitude           Float?
  // Generated column populated by the map_polish_postgis migration.
  // Prisma treats it as Unsupported (read-only) — never set it from app code.
  geom                Unsupported("geography(Point,4326)")?
  geocodeAccuracy     String?
  fullAddressVisible  Boolean            @default(false)
  rent                Int
  rentPeriod          RentPeriod         @default(YEAR)
  listingType         ListingType        @default(RENT)
  currency            String             @default("NGN")
  agencyFee           Int?
  agencyFeeMode       FeeMode            @default(FIXED)
  legalFee            Int?
  legalFeeMode        FeeMode            @default(FIXED)
  cautionDeposit      Int?
  serviceCharge       Int?
  negotiable          Boolean            @default(false)
  status              PropertyStatus     @default(PENDING)
  availabilityStatus  AvailabilityStatus @default(AVAILABLE_NOW)
  availableFrom       DateTime?
  minimumLease        String?
  isRented            Boolean            @default(false)
  rentStartDate       DateTime?
  rentExpiryDate      DateTime?
  views               Int                @default(0)
  contactCount        Int                @default(0)
  savedCount          Int                @default(0)
  // Agent attribution. When listedByAgent=true the public UI shows
  // "Listed by UNO" and the landlord field points to the agent user, not
  // the property's owner. Off-platform owner fields capture the real
  // owner's contact details for the in-house agent's records only —
  // they are never shown to renters.
  listedByAgent          Boolean         @default(false)
  offPlatformOwnerName   String?
  offPlatformOwnerPhone  String?
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedBy          String?
  verifiedAt          DateTime?
  rejectionReason     String?
  // Auto-publish gate signals (set on submit). JSON shape mirrors GateSignals
  // in src/lib/gate.ts. Used by admin queue to show why a listing was held.
  verificationSignals Json?
  verificationRequestedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  submittedAt         DateTime?
  approvedAt          DateTime?
  goesLiveAt          DateTime?
  deletedAt           DateTime?
  favourites          Favourite[]
  contactRequests     ContactRequest[]

  @@index([deletedAt])
}

enum PropertyKind {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum FeeMode {
  FIXED
  PERCENT
}

enum PropertyType {
  // Legacy (kept for back-compat with existing rows)
  FLAT
  HOUSE
  DUPLEX
  SELF_CONTAIN
  BUNGALOW
  COMMERCIAL
  LAND
  // Residential
  TERRACE
  DETACHED
  SEMI_DETACHED
  PENTHOUSE
  STUDIO
  MINI_FLAT
  SHARED_ROOM
  // Commercial
  OFFICE
  SHOP
  WAREHOUSE
  COWORKING
  EVENT_CENTRE
  HOTEL_SHORTLET
  PLAZA_UNIT
  // Land
  RESIDENTIAL_PLOT
  COMMERCIAL_PLOT
  AGRICULTURAL_LAND
  MIXED_USE_LAND
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum RentPeriod {
  MONTH
  YEAR
}

enum ListingType {
  RENT
  LEASE
  SALE
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  RENTED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE_NOW
  AVAILABLE_FROM
  RENTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Server-side wizard draft. Holds the wizard payload as JSON plus a few denormalized
/// fields so we can render a card on My Listings without parsing the JSON. Lives until
/// the user submits (then we create a Property and delete the draft) or deletes it.
model PropertyDraft {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Denormalized hints for rendering the IN_PROGRESS card without decoding JSON.
  titleHint      String?
  addressHint    String?  // e.g. "Use-Ofot, Nwaniba Road"
  mainPhotoUrl   String?

  // Full wizard state (mirrors ListPropertyData from the Zustand store).
  data           Json
  currentStep    Int      @default(1)
  completedSteps Int[]    @default([])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isMain     Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Favourite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model SavedSearch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  criteria        Json
  isActive        Boolean  @default(true)
  notifyInstant   Boolean  @default(true)
  notifyEmail     Boolean  @default(false)
  lastCheckedAt   DateTime?
  newResultsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactRequest {
  id            String        @id @default(cuid())
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id])
  tenantId      String
  tenant        User          @relation("TenantContacts", fields: [tenantId], references: [id])
  tenantName    String
  tenantPhone   String
  tenantEmail   String?
  message       String?
  contactMethod ContactMethod
  status        ContactStatus @default(UNREAD)
  readAt        DateTime?
  respondedAt   DateTime?
  source        String?
  createdAt     DateTime      @default(now())
}

enum ContactStatus {
  UNREAD
  READ
  RESPONDED
  ARCHIVED
}

// Phase 2 reserved — table exists from day one so the read side (avg
// rating on /agent/[slug]) can ship without a later migration. Writes
// are gated behind Phase 2 UI; no API routes are wired yet.
model AgentReview {
  id         String   @id @default(cuid())
  agentId    String
  agent      User     @relation("AgentReviewed", fields: [agentId], references: [id])
  authorId   String
  author     User     @relation("AgentReviewAuthor", fields: [authorId], references: [id])
  rating     Int
  comment    String?
  propertyId String?
  createdAt  DateTime @default(now())

  @@index([agentId, createdAt])
  @@unique([agentId, authorId, propertyId])
}
