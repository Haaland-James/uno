# ─────────────────────────────────────────────────────────────────────────────
# Template for the three secret files on the VPS. Never commit the real ones.
# Generate passwords with:  openssl rand -hex 24
# All three files: owner uno-deploy, chmod 600.
# ─────────────────────────────────────────────────────────────────────────────

# ===== /opt/uno/.env  (compose interpolation; deploy.sh rewrites the *_TAG lines) =====
POSTGRES_PASSWORD=
UNO_PROD_DB_PASSWORD=
UNO_STAGING_DB_PASSWORD=
PROD_TAG=
STAGING_TAG=


# ===== /opt/uno/app.production.env =====
DATABASE_URL=postgresql://uno_prod:<UNO_PROD_DB_PASSWORD>@db:5432/uno_prod?schema=public
DIRECT_URL=postgresql://uno_prod:<UNO_PROD_DB_PASSWORD>@db:5432/uno_prod?schema=public
NEXTAUTH_URL=https://uno.srv602517.hstgr.cloud
NEXTAUTH_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAPBOX_SERVER_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ===== /opt/uno/app.staging.env =====
# Same keys as production, except:
DATABASE_URL=postgresql://uno_staging:<UNO_STAGING_DB_PASSWORD>@db:5432/uno_staging?schema=public
DIRECT_URL=postgresql://uno_staging:<UNO_STAGING_DB_PASSWORD>@db:5432/uno_staging?schema=public
NEXTAUTH_URL=https://staging-uno.srv602517.hstgr.cloud
# Use a DIFFERENT NEXTAUTH_SECRET from production so sessions don't cross over.
